flowchart LR
    S(["In an interventional<br/>study, every adverse event<br/>must be assessed and<br/>recorded on the AE<br/>Assessment Log and in the<br/>source documents"]) --> Q1{"Does it meet any<br/>one of the<br/>seriousness criteria?"}
    Q1 -->|"No"| E1(["`**Non-serious AE**<br/>No SAE report.`"])
    Q1 -->|"Yes"| SP["Report every serious<br/>adverse event to the<br/>sponsor within 24 hours of<br/>the principal investigator<br/>learning of it, unless the<br/>REB-approved protocol sets<br/>a different timeline"]
    SP --> QR{"Is the site under<br/>the MUHC REB's<br/>approval?"}
    SP --> Q3{"Is it a drug or<br/>natural health product<br/>trial that needs<br/>Health Canada's<br/>authorization?"}
    QR -->|"Yes"| Q2{"Does the principal<br/>investigator judge that<br/>it meets all three of<br/>the REB's criteria?"}
    QR -->|"No, another Quebec<br/>REB reviews the study"| E8("`**Report to the reviewing**<br/>**REB, the MUHC REB and**<br/>**the Personne mandatée**<br/>For an SAE at the MUHC<br/>that is unexpected and is<br/>related or possibly<br/>related to the study,<br/>report to the reviewing<br/>REB by its own procedure.<br/>Also report it in Nagano<br/>to the MUHC REB and the<br/>MUHC's Personne mandatée,<br/>without waiting for the<br/>reviewing REB's decision.`")
    Q2 -->|"Yes"| E2(["`**Expedited REB report**<br/>Report it in Nagano<br/>on form F3H, by<br/>the REB's deadline.`"])
    Q2 -->|"No"| E3(["`**No expedited REB report**<br/>It should be submitted<br/>with the REB's annual<br/>continuing review.`"])
    Q3 -->|"No"| E7(["`**No SAE report to**<br/>**Health Canada**<br/>A device incident, or a<br/>reaction to a marketed<br/>product, has its own<br/>report.`"])
    Q3 -->|"Yes"| Q4{"Are you the<br/>sponsor-investigator?"}
    Q4 -->|"No"| E4(["`**Reported by the sponsor**<br/>The sponsor reports it to<br/>Health Canada when it<br/>meets Health Canada's<br/>criteria.`"])
    Q4 -->|"Yes"| Q5{"Does it meet<br/>Health Canada's<br/>criteria?"}
    Q5 -->|"Yes"| E5(["`**Report to Health Canada**<br/>**yourself**<br/>Report it whether or not it<br/>meets the REB's criteria.`"])
    Q5 -->|"No"| E6(["`**No report to**<br/>**Health Canada**`"])

